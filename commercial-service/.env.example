# Durable PostgreSQL ledger
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Public HTTPS origin of the deployed ANPOS commercial/community service.
# No path query or fragment; used to derive the fixed OAuth callback and Setup URL.
ANPOS_PUBLIC_BASE_URL=https://license.example.com

# Encrypts short-lived HttpOnly Community browser sessions and OAuth state.
# Generate a high-entropy random value (at least 32 characters) and store only in secrets management.
ANPOS_SESSION_SECRET=replace-with-at-least-32-random-characters

# Customer-facing/public GitHub Marketplace App.
# This App owns the Marketplace listing, Marketplace account reconciliation, and Community audit consent surface.
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
GITHUB_MARKETPLACE_APP_ID=123456
GITHUB_MARKETPLACE_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub App OAuth client credentials for the Setup URL -> PKCE OAuth -> Community session flow.
# The client secret is server-side only. Never expose it to browser JavaScript or commit it.
GITHUB_MARKETPLACE_CLIENT_ID=Iv1.replace-with-real-client-id
GITHUB_MARKETPLACE_CLIENT_SECRET=replace-with-real-github-client-secret

# REAL GitHub Marketplace plan ID for the free Community offering after the listing exists.
# Keep Community outside ANPOS_MARKETPLACE_PLAN_MAP; it has zero paid entitlements.
ANPOS_COMMUNITY_MARKETPLACE_PLAN_ID=123455

# Separate vendor-only/private GitHub App.
# This App is installed only on the vendor private template repository and must NOT
# reuse the Marketplace App ID/private key. Keep it private to the vendor account.
GITHUB_VENDOR_APP_ID=654321
GITHUB_VENDOR_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...different-key...\n-----END RSA PRIVATE KEY-----"

# Map REAL paid GitHub Marketplace plan IDs to paid ANPOS plan IDs after listing setup.
# Never add Community here; its identity is ANPOS_COMMUNITY_MARKETPLACE_PLAN_ID.
ANPOS_MARKETPLACE_PLAN_MAP='{"123456":"developer","123457":"pro","123458":"team","123459":"enterprise"}'

# Organization seat capacity is operator-controlled. Marketplace per-unit purchases
# use GitHub's unit_count when present; these values are the fail-closed capacity
# for flat-rate/null-unit plans. REPLACE these example business limits before launch.
ANPOS_ORG_SEAT_LIMITS='{"developer":1,"pro":1,"team":10,"enterprise":50}'

# Signed portable entitlement key (Ed25519 PKCS8 PEM required)
ANPOS_ENTITLEMENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ANPOS_ENTITLEMENT_KEY_ID=anpos-entitlement-2026-01
ANPOS_ENTITLEMENT_ISSUER=https://license.example.com
ANPOS_ENTITLEMENT_TTL_SECONDS=86400

# Operator-only reconciliation APIs
ANPOS_OPERATOR_TOKEN=replace-with-at-least-32-random-characters

# Vendor private template distribution. The VENDOR GitHub App installation must have
# Contents: read on this repo for archive delivery. Archive delivery is the
# recommended scalable distribution path.
GITHUB_VENDOR_INSTALLATION_ID=12345678
ANPOS_PRIVATE_TEMPLATE_REPO=Vertex-Systems-Network/anpos-commercial-template
ANPOS_TEMPLATE_REF=main

# Optional collaborator-based provisioning is OFF by default because GitHub limits
# invitations per repository and this mode needs Administration: write permission
# on the VENDOR App only. Never add that permission to the Marketplace App.
ANPOS_COLLABORATOR_PROVISIONING_ENABLED=false

# Marketplace webhooks are small; bound request memory even if Content-Length is absent.
ANPOS_MAX_WEBHOOK_BYTES=1048576