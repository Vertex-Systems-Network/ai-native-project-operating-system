# Durable PostgreSQL ledger
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# GitHub Marketplace / GitHub App
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Map REAL GitHub Marketplace plan IDs to ANPOS plan IDs after listing setup.
ANPOS_MARKETPLACE_PLAN_MAP='{"123456":"developer","123457":"pro","123458":"team","123459":"enterprise"}'

# Organization seat capacity is operator-controlled. Marketplace per-unit purchases
# use GitHub's unit_count when present; these values are the fail-closed capacity
# for flat-rate/null-unit plans. REPLACE these example business limits before launch.
ANPOS_ORG_SEAT_LIMITS='{"developer":1,"pro":1,"team":10,"enterprise":50}'

# Signed portable entitlement key (Ed25519 PKCS8 PEM required)
ANPOS_ENTITLEMENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ANPOS_ENTITLEMENT_KEY_ID=anpos-entitlement-2026-01
ANPOS_ENTITLEMENT_ISSUER=https://license.example.com
ANPOS_ENTITLEMENT_TTL_SECONDS=86400

# Operator-only reconciliation APIs
ANPOS_OPERATOR_TOKEN=replace-with-at-least-32-random-characters

# Vendor private template distribution. The GitHub App installation must have
# Contents: read on this repo for archive delivery. Archive delivery is the
# recommended scalable distribution path.
GITHUB_VENDOR_INSTALLATION_ID=12345678
ANPOS_PRIVATE_TEMPLATE_REPO=Vertex-Systems-Network/anpos-commercial-template
ANPOS_TEMPLATE_REF=main

# Optional collaborator-based provisioning is OFF by default because GitHub limits
# invitations per repository and this mode needs Administration: write permission.
ANPOS_COLLABORATOR_PROVISIONING_ENABLED=false

# Marketplace webhooks are small; bound request memory even if Content-Length is absent.
ANPOS_MAX_WEBHOOK_BYTES=1048576
