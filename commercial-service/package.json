{
  "name": "anpos-commercial-service",
  "version": "0.4.10",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/guarded-build-migrate.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "certify": "npm run typecheck && npm run test:unit && npm run build",
    "verify:e2e": "tsx scripts/verify-repository-supervisor-e2e.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@vercel/oidc": "3.2.0",
    "@vercel/sandbox": "3.5.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "anpos": {
    "source_protocol_version": "1.4.0",
    "runtime_contract": "split-github-app-v1"
  }
