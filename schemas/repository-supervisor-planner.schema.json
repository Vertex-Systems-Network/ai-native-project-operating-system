{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.local/schemas/repository-supervisor-planner.schema.json",
  "title": "ANPOS Repository Supervisor Planner Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "protocol_baseline",
    "modes",
    "classification_contract",
    "project_preserve_exact",
    "bootstrap_transform_exact",
    "bootstrap_transform_prefixes",
    "shared_merge_exact",
    "shared_merge_prefixes",
    "source_owned_prefixes",
    "target_only_rule",
    "adoption_collision_rule",
    "upgrade_project_state_rule",
    "requirements_83_96_rule",
    "material_ai_drift_prefixes",
    "max_release_files",
    "max_plan_actions",
    "rules",
    "apply_runtime"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "status": {
      "const": "source_planner_policy"
    },
    "protocol_baseline": {
      "const": "1.4.0"
    },
    "modes": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bootstrap_empty",
          "bootstrap_child",
          "adopt_existing",
          "repair_partial",
          "upgrade_active"
        ]
      }
    },
    "classification_contract": {
      "type": "object"
    },
    "project_preserve_exact": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bootstrap_transform_exact": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bootstrap_transform_prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shared_merge_exact": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shared_merge_prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_owned_prefixes": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_only_rule": {
      "const": "preserve"
    },
    "adoption_collision_rule": {
      "const": "manual_merge"
    },
    "upgrade_project_state_rule": {
      "const": "preserve_and_migration_review_when_release_differs"
    },
    "requirements_83_96_rule": {
      "const": "preserve_verified_evidence_never_reset_on_adoption_or_upgrade"
    },
    "material_ai_drift_prefixes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_release_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "max_plan_actions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "rules": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "apply_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "runner",
        "sandbox_protocol_version",
        "eligible_modes",
        "conflict_free_required",
        "bootstrap_empty",
        "conflict_resolution",
        "customer_provider_token_forwarded_to_sandbox",
        "verified_release_materialization",
        "output_contract",
        "apply_lease_minutes",
        "merge_requires_sandbox_receipt",
        "empty_repository_direct_default_branch_exception",
        "empty_repository_seed_path",
        "empty_repository_seed_removed_on_feature_branch",
        "empty_repository_explicit_confirmation_required",
        "empty_repository_recovery_after_seed_failure",
        "conflict_resolution_requires_exact_source_plan_hash",
        "conflict_resolution_requires_exact_target_git_object",
        "migration_review_use_release_requires_acknowledgement",
        "resolved_plan_is_new_immutable_plan"
      ],
      "properties": {
        "source": {
          "const": "commercial-service/lib/repository-supervisor-full-apply.ts"
        },
        "runner": {
          "const": "commercial-service/lib/full-plan-sandbox-runner.ts"
        },
        "sandbox_protocol_version": {
          "const": 2
        },
        "eligible_modes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bootstrap_empty",
              "bootstrap_child",
              "adopt_existing",
              "repair_partial",
              "upgrade_active"
            ]
          }
        },
        "conflict_free_required": {
          "const": true
        },
        "bootstrap_empty": {
          "const": "guarded_root_seed_then_feature_branch_pr_v1"
        },
        "conflict_resolution": {
          "const": "explicit_resolved_plan_v1"
        },
        "customer_provider_token_forwarded_to_sandbox": {
          "const": false
        },
        "verified_release_materialization": {
          "const": "exact_private_template_git_blobs"
        },
        "output_contract": {
          "const": "exact_planned_paths_sha256_verified"
        },
        "apply_lease_minutes": {
          "const": 20
        },
        "merge_requires_sandbox_receipt": {
          "const": true
        },
        "empty_repository_direct_default_branch_exception": {
          "const": "single_verified_zero_parent_seed_only"
        },
        "empty_repository_seed_path": {
          "const": ".anpos-bootstrap-seed"
        },
        "empty_repository_seed_removed_on_feature_branch": {
          "const": true
        },
        "empty_repository_explicit_confirmation_required": {
          "const": true
        },
        "empty_repository_recovery_after_seed_failure": {
          "const": "apply_recovery_required"
        },
        "conflict_resolution_requires_exact_source_plan_hash": {
          "const": true
        },
        "conflict_resolution_requires_exact_target_git_object": {
          "const": true
        },
        "migration_review_use_release_requires_acknowledgement": {
          "const": true
        },
        "resolved_plan_is_new_immutable_plan": {
          "const": true
        }
      }
    }
  }
}
