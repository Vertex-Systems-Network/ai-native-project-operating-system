{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.local/schemas/agent-work-queue.schema.json",
  "title": "ANPOS Agent Work Queue",
  "type": "object",
  "required": ["schema_version", "coordination_mode", "slots", "status_values"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 3},
    "coordination_mode": {"const": "multi_agent"},
    "updated_at": {"type": ["string", "null"]},
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "status", "dependencies", "eligibility"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "priority": {"type": "integer"},
          "status": {"enum": ["free", "claimed", "in_progress", "blocked", "submitted_for_review", "changes_requested", "approved", "merged", "completed", "canceled"]},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "eligibility": {"type": "array", "items": {"type": "string"}},
          "claimant": {"type": ["string", "null"]},
          "claim_id": {"type": ["string", "null"]},
          "claim_nonce": {"type": ["string", "null"]},
          "claim_branch": {"type": ["string", "null"]},
          "coordination_epoch": {"type": ["integer", "null"], "minimum": 0},
          "fencing_token": {"type": ["string", "null"]},
          "lease_expires_at": {"type": ["string", "null"]},
          "base_sha": {"type": ["string", "null"]},
          "pm_reference": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["claimed", "in_progress", "blocked", "submitted_for_review", "changes_requested", "approved"]}}},
            "then": {"required": ["claimant", "claim_id", "claim_branch", "coordination_epoch", "fencing_token", "lease_expires_at", "base_sha"]}
          }
        ],
        "additionalProperties": true
      }
    },
    "status_values": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
