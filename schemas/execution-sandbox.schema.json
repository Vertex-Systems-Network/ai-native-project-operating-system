{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.local/schemas/execution-sandbox.schema.json",
  "title": "ANPOS Repository Supervisor Execution Sandbox Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "implementation_scope",
    "driver_required",
    "allowed_isolation",
    "local_process_fallback",
    "workspace_mode",
    "network",
    "command",
    "environment",
    "limits",
    "evidence",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "runtime_contract"
    },
    "implementation_scope": {
      "const": "repository_supervisor_execution"
    },
    "driver_required": {
      "const": true
    },
    "allowed_isolation": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "container",
          "microvm",
          "remote_ephemeral"
        ]
      }
    },
    "local_process_fallback": {
      "const": false
    },
    "workspace_mode": {
      "const": "ephemeral_copy_on_write"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "allowed"
      ],
      "properties": {
        "default": {
          "const": "deny"
        },
        "allowed": {
          "type": "array",
          "items": {
            "const": "deny"
          },
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_interpolation",
        "max_args",
        "max_arg_bytes"
      ],
      "properties": {
        "shell_interpolation": {
          "const": false
        },
        "max_args": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_arg_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_contains_names_only",
        "max_names",
        "secret_values_resolved_server_side"
      ],
      "properties": {
        "request_contains_names_only": {
          "const": true
        },
        "max_names": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "secret_values_resolved_server_side": {
          "const": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_timeout_seconds",
        "max_timeout_seconds",
        "default_output_bytes",
        "max_output_bytes"
      ],
      "properties": {
        "default_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "default_output_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8388608
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 6,
      "items": {
        "enum": [
          "driver_id",
          "isolation",
          "exit_code",
          "timed_out",
          "output_truncated",
          "duration_ms"
        ]
      },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
