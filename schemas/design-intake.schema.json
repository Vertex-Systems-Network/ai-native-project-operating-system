{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.local/schemas/design-intake.schema.json",
  "title": "ANPOS Design Intake",
  "type": "object",
  "required": ["schema_version", "status", "audit_status", "approval_status", "node_ids"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 2},
    "status": {"type": "string"},
    "source_url": {"type": ["string", "null"]},
    "node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "version_or_revision": {"type": ["string", "null"]},
    "snapshot_ref": {"type": ["string", "null"]},
    "approval_status": {"enum": ["not_approved", "approved", "rejected", "superseded"]}
  },
  "allOf": [
    {
      "if": {"properties": {"approval_status": {"const": "approved"}}},
      "then": {"required": ["approved_by", "approved_at"], "anyOf": [{"required": ["version_or_revision"]}, {"required": ["snapshot_ref"]}]}
    }
  ],
  "additionalProperties": true
}
