{
  "schema_version": 2,
  "status": "template_blueprint",
  "activation_scope": "child_project_only",
  "apply_to_template_source": false,
  "setup_flow": {
    "install_automatically_in_child_project": true,
    "install_universal_baseline_during_project_initialization": true,
    "install_stack_specific_tools_after_stack_approval": true,
    "do_not_require_separate_user_consent_for_normal_non_destructive_quality_tooling": true,
    "if_permissions_or_platform_settings_block_installation": "tell_user_exactly_what_access_or_manual_action_is_required_and_mark_setup_pending",
    "verify_after_installation": true
  },
  "universal_required_checks": [
    "repository-integrity",
    "dependency-review",
    "codeql-actions"
  ],
  "scheduled_security_quality": [
    "ossf-scorecard"
  ],
  "stack_specific_policy": {
    "generate_after_stack_approval": true,
    "required_categories": [
      "formatter",
      "linter",
      "type_or_static_analysis",
      "unit_tests",
      "integration_tests",
      "build",
      "dependency_audit",
      "security_scanning"
    ],
    "additional_when_relevant": [
      "contract_tests",
      "e2e_tests",
      "accessibility_tests",
      "performance_tests",
      "migration_tests",
      "container_scan",
      "iac_scan",
      "license_policy",
      "coverage_gate"
    ]
  },
  "quality_gate_rules": {
    "no_merge_on_failed_required_check": true,
    "no_silent_check_skips": true,
    "changed_behavior_requires_tests": true,
    "generated_code_requires_validation": true,
    "critical_or_high_security_findings_block_merge": true,
    "new_dependencies_require_dependency_review": true,
    "github_actions_must_be_pinned_to_full_commit_sha": true
  },
  "tool_selection_rule": "In the child project, prefer mature, actively maintained, ecosystem-standard tools. Record the selected tools and rationale after the application stack is known."
}
