{
  "schema_version": 2,
  "default_owner_role": "worker",
  "protected_control_plane_default_owner_roles": ["supervisor", "security", "architecture", "devops"],
  "rules": [
    {"pattern": "/AGENTS.md", "owner_roles": ["supervisor", "security", "architecture"], "review_required": true, "independent_review_required": true},
    {"pattern": "/.ai/**", "owner_roles": ["supervisor", "security", "architecture"], "review_required": true, "independent_review_required": true},
    {"pattern": "/CLAUDE.md", "owner_roles": ["supervisor", "security"], "review_required": true},
    {"pattern": "/GEMINI.md", "owner_roles": ["supervisor", "security"], "review_required": true},
    {"pattern": "/.cursor/**", "owner_roles": ["supervisor", "security"], "review_required": true},
    {"pattern": "/.windsurf/**", "owner_roles": ["supervisor", "security"], "review_required": true},
    {"pattern": "/.github/**", "owner_roles": ["supervisor", "devops", "security"], "review_required": true},
    {"pattern": "/blueprints/**", "owner_roles": ["supervisor", "devops", "security"], "review_required": true, "independent_review_required": true},
    {"pattern": "/PROJECT-INITIALIZATION.md", "owner_roles": ["supervisor", "architecture", "security"], "review_required": true},
    {"pattern": "/PROJECT-MANAGEMENT.md", "owner_roles": ["supervisor", "architecture"], "review_required": true},
    {"pattern": "/AUTO-AGENT.md", "owner_roles": ["supervisor", "security"], "review_required": true},
    {"pattern": "/SUPERVISOR.md", "owner_roles": ["supervisor", "security", "architecture"], "review_required": true},
    {"pattern": "/ORCHESTRATOR.md", "owner_roles": ["supervisor", "security", "architecture", "devops"], "review_required": true},
    {"pattern": "/MULTI-AGENT-ORCHESTRATION.md", "owner_roles": ["supervisor", "security", "architecture"], "review_required": true},
    {"pattern": "/CONTROL-PLANE-SECURITY.md", "owner_roles": ["security", "supervisor"], "review_required": true},
    {"pattern": "/config/ai/agent-catalog.json", "owner_roles": ["supervisor", "security"], "review_required": true},
    {"pattern": "/config/coordination/**", "owner_roles": ["supervisor"], "review_required": true},
    {"pattern": "/config/protocol/**", "owner_roles": ["supervisor", "architecture"], "review_required": true},
    {"pattern": "/config/security/**", "owner_roles": ["security", "supervisor"], "review_required": true},
    {"pattern": "/config/consent/**", "owner_roles": ["supervisor", "security"], "review_required": true},
    {"pattern": "/config/github/**", "owner_roles": ["supervisor", "devops", "security"], "review_required": true},
    {"pattern": "/config/quality/**", "owner_roles": ["supervisor", "qa", "security"], "review_required": true},
    {"pattern": "/config/runtime/**", "owner_roles": ["supervisor", "devops"], "review_required": true},
    {"pattern": "/config/release/**", "owner_roles": ["supervisor", "devops", "security"], "review_required": true},
    {"pattern": "/schemas/**", "owner_roles": ["supervisor", "architecture", "security"], "review_required": true},
    {"pattern": "/scripts/**", "owner_roles": ["supervisor", "devops", "security"], "review_required": true, "independent_review_required": true},
    {"pattern": "/SECURITY.md", "owner_roles": ["security", "supervisor"], "review_required": true}
  ],
  "codeowners_policy": "Bootstrap must render repository-valid CODEOWNERS identities from authorized GitHub users/teams. Role names are policy identities, not literal GitHub handles. Control-plane paths must not inherit ordinary Worker ownership."
}
