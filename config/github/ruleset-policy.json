{
  "schema_version": 2,
  "status": "template_blueprint",
  "activation_scope": "child_project_only",
  "template_source_enforcement": "not_applicable",
  "scope": "default_branch",
  "target_branch": "main",
  "setup_flow": {
    "ask_user_before_applying": true,
    "preferred_action": "Apply Recommended GitHub Rules",
    "secondary_action": "Review GitHub Rules",
    "if_admin_capable_ai": "apply_after_user_approval_then_re_read_and_verify",
    "if_ai_cannot_apply": "show_exact_manual_rules_setup_steps_and_mark_pending",
    "never_claim_applied_without_github_verification": true
  },
  "repository_settings": {
    "delete_branch_on_merge": true
  },
  "rules": {
    "require_pull_request": true,
    "required_approving_reviews": 1,
    "dismiss_stale_reviews_on_push": true,
    "require_approval_of_most_recent_reviewable_push": true,
    "require_conversation_resolution": true,
    "require_status_checks": true,
    "require_branch_up_to_date": true,
    "block_force_pushes": true,
    "block_branch_deletion": true,
    "require_linear_history": true,
    "required_status_checks": [
      "AI Native Quality Gates / repository-integrity",
      "Dependency Review / dependency-review",
      "CodeQL / analyze-actions"
    ]
  },
  "merge_policy": {
    "preferred_method": "squash",
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_squash_merge": true,
    "allow_auto_merge": true,
    "allow_update_branch": true,
    "merge_queue": "recommended_when_available"
  },
  "review_policy": {
    "supervisor_cannot_self_approve_high_risk_changes": true,
    "security_critical_changes_require_independent_review": true,
    "shared_coordination_state_requires_supervisor_review": true
  },
  "notes": [
    "This file is a reusable desired-policy blueprint, not evidence that the template source repository has these rules applied.",
    "Apply only to a child/new project after the user approves the rules setup.",
    "Required status-check names must be verified in that child repository after the quality workflows are installed and have run successfully."
  ]
}
