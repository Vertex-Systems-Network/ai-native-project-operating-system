{
  "schema_version": 1,
  "status": "contract_only_no_premium_payload_in_canonical_source",
  "activation_scope": "commercial_distribution_only",
  "purpose": "Define the certifiable boundary for a future private ANPOS Premium Pack without placing premium customer assets in canonical public source or claiming Pro value exists before the private pack is implemented and verified.",
  "manifest_name": "ANPOS-PREMIUM-MANIFEST.json",
  "manifest_schema": "schemas/premium-pack-manifest.schema.json",
  "verifier": "scripts/verify_premium_pack.py",
  "private_repository_required": true,
  "canonical_source_must_not_contain_premium_payload": true,
  "source_contract_is_not_premium_entitlement_value": true,
  "allowed_asset_classes": [
    "premium_blueprint",
    "premium_provider_adapter",
    "premium_governance_recipe",
    "premium_documentation"
  ],
  "allowed_path_prefixes": {
    "premium_blueprint": "premium/blueprints/",
    "premium_provider_adapter": "premium/providers/",
    "premium_governance_recipe": "premium/governance/",
    "premium_documentation": "premium/docs/"
  },
  "forbidden_pack_paths": [
    ".git/",
    ".github/",
    ".ai/",
    "commercial-service/",
    "config/",
    "schemas/",
    "scripts/",
    "tests/"
  ],
  "verification_rules": {
    "manifest_must_validate_against_schema": true,
    "every_payload_file_must_be_manifested": true,
    "unmanifested_payload_files_forbidden": true,
    "file_sha256_and_byte_count_must_match": true,
    "symlinks_forbidden": true,
    "path_traversal_forbidden": true,
    "operator_or_customer_secret_markers_forbidden": true,
    "exact_copy_of_canonical_tracked_file_forbidden": true,
    "source_protocol_compatibility_must_include_requested_protocol": true,
    "provider_adapter_claim_requires_provider_manifest_entry": true,
    "capability_ids_must_resolve_to_manifest_capabilities": true
  },
  "provider_adapter_truth": {
    "provider_name_is_not_partnership_or_certification_claim": true,
    "provider_specific_capabilities_require_implementation_and_tests": true,
    "runtime_credentials_or_oauth_secrets_must_not_ship_in_pack": true,
    "live_provider_support_requires_separate_runtime_evidence": true
  },
  "distribution_boundary": {
    "premium_pack_requires_active_entitlement_before_distribution": true,
    "private_pack_repository_is_not_canonical_public_source": true,
    "manifest_receipt_must_bind_pack_version_and_content_set": true,
    "mutable_branch_name_is_not_release_identity": true,
    "future_distribution_must_use_immutable_verified_revision_or_artifact": true
  },
  "current_readiness": {
    "contract_defined": true,
    "private_premium_repository_exists": false,
    "premium_blueprint_payload_implemented": false,
    "premium_provider_adapter_payload_implemented": false,
    "entitlement_gated_premium_distribution_implemented": false,
    "pro_sale_ready": false
  },
  "rule": "This contract reduces future implementation ambiguity but does not satisfy premium_blueprints or premium_provider_adapters as customer value. Pro remains blocked until a real private pack contains distinct premium assets, passes this verifier, is bound to immutable distribution, and passes entitlement-gated production E2E."
}
