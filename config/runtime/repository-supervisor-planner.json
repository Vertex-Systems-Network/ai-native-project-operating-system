{
  "schema_version": 3,
  "status": "source_planner_policy",
  "protocol_baseline": "1.4.0",
  "modes": [
    "bootstrap_empty",
    "bootstrap_child",
    "adopt_existing",
    "repair_partial",
    "upgrade_active"
  ],
  "classification_contract": {
    "bootstrap_empty": [
      "empty_repository"
    ],
    "bootstrap_child": [
      "uninitialized_child"
    ],
    "adopt_existing": [
      "not_anpos"
    ],
    "repair_partial": [
      "partial_or_malformed"
    ],
    "upgrade_active": [
      "active_project"
    ]
  },
  "project_preserve_exact": [
    "PROJECT-IDEA.md",
    "config/protocol/instance.json",
    "config/ai/project-state.json",
    "config/ai/memory-provenance.json",
    "config/ai/agent-catalog.json",
    "config/coordination/agent-work-queue.json",
    "config/coordination/supervisor-state.json",
    "config/coordination/merge-events.json",
    "config/coordination/agent-alerts.json",
    "config/consent/consent-requests.json",
    "config/integrations/project-management.json",
    "config/integrations/linear-sync.json",
    "config/assurance/assurance-state.json",
    "config/research/evidence-registry.json",
    "config/architecture/decision-records.json",
    "config/ai/asset-registry.json",
    "config/operations/runbooks-and-drills.json",
    "config/audit/audit-journal.json",
    "config/risk/risk-register.json",
    ".github/CODEOWNERS"
  ],
  "bootstrap_transform_exact": [
    "config/protocol/instance.json",
    "config/ai/project-state.json",
    "config/ai/memory-provenance.json",
    "config/ai/agent-catalog.json",
    "config/coordination/agent-work-queue.json",
    "config/coordination/supervisor-state.json",
    "config/coordination/merge-events.json",
    "config/coordination/agent-alerts.json",
    "config/consent/consent-requests.json",
    "config/integrations/project-management.json",
    "config/integrations/linear-sync.json",
    "config/quality/quality-policy.json",
    "config/github/ruleset-policy.json",
    "config/security/control-plane-policy.json",
    "config/security/trust-policy.json",
    "config/security/threat-model.json",
    "config/runtime/budgets.json",
    "config/release/release-policy.json",
    "config/data/data-governance.json",
    "config/operations/operations-policy.json",
    "config/contracts/migration-policy.json",
    "config/integrations/sync-authority.json",
    "config/design/design-assurance.json",
    "config/testing/conformance-scenarios.json",
    "config/assurance/assurance-state.json",
    "config/research/evidence-registry.json",
    "config/assurance/runtime-executors.json",
    "config/ai/ai-evaluation-policy.json",
    "config/product/product-validation.json",
    "config/product/product-analytics.json",
    "config/product/experimentation-policy.json",
    "config/release/progressive-delivery.json",
    "config/quality/engineering-review-policy.json",
    "config/ai/responsible-ai-policy.json",
    "config/compliance/compliance-profile.json",
    "config/contracts/deprecation-policy.json",
    "config/architecture/decision-records.json",
    "config/ai/asset-registry.json",
    "config/operations/runbooks-and-drills.json",
    "config/audit/audit-journal.json",
    "config/risk/risk-register.json",
    ".github/dependabot.yml",
    ".github/CODEOWNERS"
  ],
  "bootstrap_transform_prefixes": [
    ".github/workflows/"
  ],
  "shared_merge_exact": [
    "README.md",
    ".gitignore"
  ],
  "shared_merge_prefixes": [
    ".github/"
  ],
  "source_owned_prefixes": [
    ".ai/",
    "blueprints/",
    "config/",
    "schemas/",
    "scripts/",
    "tests/"
  ],
  "target_only_rule": "preserve",
  "adoption_collision_rule": "manual_merge",
  "upgrade_project_state_rule": "preserve_and_migration_review_when_release_differs",
  "requirements_83_96_rule": "preserve_verified_evidence_never_reset_on_adoption_or_upgrade",
  "material_ai_drift_prefixes": [
    ".ai/",
    "config/ai/"
  ],
  "max_release_files": 5000,
  "max_plan_actions": 5000,
  "rules": [
    "Canonical ANPOS source is never a planner target.",
    "All plans bind to canonical repository identity and the exact observed target head when one exists.",
    "All full-mode plans bind to an immutable verified private-template release_ref, source_revision and source_tree.",
    "Target-only files are preserved and never scheduled for deletion.",
    "Adoption never auto-overwrites an existing mismatched target path.",
    "Upgrade never blindly replaces project-specific state or Requirements 83-96 evidence.",
    "Shared README, .gitignore and existing GitHub policy/workflow collisions require merge/review rather than blind replacement.",
    "Material AI-control drift marks AI assurance re-verification required.",
    "Conflict-free non-empty full plans may apply only through the signed remote-ephemeral sandbox artifact channel.",
    "Manual-merge and migration-review conflicts remain hard stops until an explicit resolved plan exists.",
    "Customer GitHub credentials are never forwarded to the sandbox gateway during full-plan apply.",
    "A full-plan PR cannot merge without a persisted sandbox receipt digest.",
    "GitHub empty repositories may receive exactly one deterministic root seed commit only after explicit confirmation because raw Git refs cannot initialize an empty repository.",
    "The guarded empty-repository seed must be the zero-parent root commit on the configured default branch and must be removed by the ANPOS feature-branch commit.",
    "After the seed exists, any apply failure enters recovery-required state and must not silently reset the plan to planned.",
    "Normal non-empty Repository Supervisor flows continue to forbid direct default-branch writes."
  ],
  "apply_runtime": {
    "source": "commercial-service/lib/repository-supervisor-full-apply.ts",
    "runner": "commercial-service/lib/full-plan-sandbox-runner.ts",
    "sandbox_protocol_version": 2,
    "eligible_modes": [
      "bootstrap_empty",
      "bootstrap_child",
      "adopt_existing",
      "repair_partial",
      "upgrade_active"
    ],
    "conflict_free_required": true,
    "bootstrap_empty": "guarded_root_seed_then_feature_branch_pr_v1",
    "conflict_resolution": "pending_user_resolved_plan",
    "customer_provider_token_forwarded_to_sandbox": false,
    "verified_release_materialization": "exact_private_template_git_blobs",
    "output_contract": "exact_planned_paths_sha256_verified",
    "apply_lease_minutes": 20,
    "merge_requires_sandbox_receipt": true,
    "empty_repository_direct_default_branch_exception": "single_verified_zero_parent_seed_only",
    "empty_repository_seed_path": ".anpos-bootstrap-seed",
    "empty_repository_seed_removed_on_feature_branch": true,
    "empty_repository_explicit_confirmation_required": true,
    "empty_repository_recovery_after_seed_failure": "apply_recovery_required"
  }
}
