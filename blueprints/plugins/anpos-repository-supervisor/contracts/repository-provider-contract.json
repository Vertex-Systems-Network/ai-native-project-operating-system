{
  "schema_version": 3,
  "status": "blueprint",
  "purpose": "Provider-neutral MCP contract for ANPOS 1.4.0 repository supervision across GitHub and GitLab, including Requirements 83–96 assurance/evidence preservation.",
  "supported_provider_blueprints": [
    {
      "id": "github",
      "canonical_host": "github.com",
      "authentication": "oauth_2_1_via_mcp",
      "support_status": "adapter_required"
    },
    {
      "id": "gitlab",
      "canonical_host": "gitlab.com",
      "authentication": "oauth_2_1_via_mcp",
      "support_status": "adapter_required",
      "self_hosted": "administrator_allowlist_only"
    }
  ],
  "repository_classifications": [
    "canonical_source",
    "active_project",
    "uninitialized_child",
    "not_anpos",
    "partial_or_malformed",
    "empty_repository"
  ],
  "tools": [
    {
      "name": "repository_resolve",
      "intent": "Normalize a user-supplied repository URL, identify the provider, resolve canonical repository identity, and report authentication requirements.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "repository_url"
      ],
      "required_outputs": [
        "provider",
        "canonical_repository_id",
        "canonical_url",
        "authentication_state"
      ]
    },
    {
      "name": "repository_profile",
      "intent": "Return the authenticated provider account profile used for subsequent repository calls.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [],
      "required_outputs": [
        "provider",
        "account_id",
        "account_display_name"
      ]
    },
    {
      "name": "repository_audit",
      "intent": "Perform a bounded read-only audit and classify the target repository's ANPOS state.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id"
      ],
      "required_outputs": [
        "provider",
        "canonical_repository_id",
        "default_branch",
        "head_sha",
        "permission_level",
        "classification",
        "classification_evidence",
        "write_capability",
        "anpos_protocol_version",
        "assurance_state_summary",
        "governance_state_summary"
      ]
    },
    {
      "name": "repository_read_files",
      "intent": "Read an allowlisted bounded set of repository paths required by the active ANPOS role or adoption audit.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id",
        "ref",
        "paths"
      ],
      "required_outputs": [
        "files",
        "ref_sha"
      ]
    },
    {
      "name": "repository_plan_change",
      "intent": "Create a short-lived deterministic no-repository-write plan for a bounded development change on an already-active ANPOS project, bound to exact default-branch head plus observed blob SHA and Git mode.",
      "read_only": false,
      "destructive": false,
      "open_world": false,
      "active_project_only": true,
      "required_inputs": [
        "canonical_repository_id",
        "billing_account_id",
        "expected_target_head_sha",
        "changes",
        "commit_message"
      ],
      "required_outputs": [
        "plan_id",
        "target_head_sha",
        "plan_digest_sha256",
        "changes",
        "billing_account_id",
        "safe_to_apply",
        "expires_at"
      ],
      "server_requirements": [
        "reject_non_active_project",
        "require_authenticated_write_permission",
        "reject_secret_bearing_paths_and_obvious_secret_material",
        "bind_existing_paths_to_blob_sha_and_git_mode",
        "encrypt_change_payload_at_rest",
        "expire_plan_after_short_ttl",
        "bind_plan_to_billing_account"
      ]
    },
    {
      "name": "repository_plan_anpos_change",
      "intent": "Create a deterministic no-write ANPOS bootstrap, adoption, repair, or upgrade plan bound to an observed repository head and immutable ANPOS release.",
      "read_only": true,
      "open_world": false,
      "modes": [
        "bootstrap_empty",
        "bootstrap_child",
        "adopt_existing",
        "repair_partial",
        "upgrade_active"
      ],
      "required_inputs": [
        "canonical_repository_id",
        "mode",
        "expected_target_head_sha"
      ],
      "required_outputs": [
        "plan_id",
        "target_head_sha",
        "anpos_version",
        "anpos_release_digest",
        "new_paths",
        "merge_paths",
        "preserved_paths",
        "blocked_conflicts",
        "validation_plan",
        "safe_to_apply",
        "requirements_83_96_applicability",
        "evidence_preservation_plan",
        "protocol_migration_plan"
      ]
    },
    {
      "name": "repository_apply_anpos_change",
      "intent": "Apply a previously generated safe ANPOS plan to a feature branch using optimistic concurrency.",
      "read_only": false,
      "destructive": false,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id",
        "plan_id",
        "expected_target_head_sha",
        "branch_name",
        "idempotency_key"
      ],
      "required_outputs": [
        "branch_name",
        "resulting_head_sha",
        "applied_paths",
        "verification",
        "assurance_state_verification"
      ],
      "server_requirements": [
        "reject_if_plan_is_stale",
        "reject_if_target_head_changed",
        "reject_default_branch_direct_write_by_default",
        "reject_force_push",
        "reverify_authenticated_permission"
      ]
    },
    {
      "name": "repository_apply_change",
      "intent": "Apply one previously generated generic active-project plan to a new anpos/* feature branch using optimistic concurrency and idempotency.",
      "read_only": false,
      "destructive": false,
      "open_world": false,
      "active_project_only": true,
      "required_inputs": [
        "plan_id",
        "billing_account_id",
        "branch_name",
        "idempotency_key",
        "confirm_deletions"
      ],
      "required_outputs": [
        "branch_name",
        "base_head_sha",
        "resulting_head_sha",
        "applied_paths",
        "verification"
      ],
      "server_requirements": [
        "reject_if_plan_expired_or_already_applied_except_same_idempotent_replay",
        "reject_if_target_head_changed",
        "reverify_blob_sha_and_git_mode_preconditions",
        "reject_default_branch_direct_write",
        "require_anpos_feature_branch_prefix",
        "preserve_existing_executable_mode",
        "reject_force_push",
        "verify_created_branch_head",
        "require_same_billing_account_as_plan"
      ]
    },
    {
      "name": "repository_open_change_request",
      "intent": "Open or update the provider's PR/MR for the prepared branch.",
      "read_only": false,
      "destructive": false,
      "open_world": false,
      "required_inputs": [
        "billing_account_id",
        "plan_id",
        "canonical_repository_id",
        "head_branch",
        "base_branch",
        "expected_head_sha",
        "title",
        "body"
      ],
      "required_outputs": [
        "change_request_id",
        "url",
        "head_sha",
        "base_sha"
      ],
      "server_requirements": [
        "require_applied_plan_exact_branch_and_head_binding",
        "require_same_billing_account_as_plan",
        "record_opened_change_request_id_on_plan"
      ]
    },
    {
      "name": "repository_get_change_request",
      "intent": "Read current PR/MR metadata, reviews, mergeability, and head/base identity.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id",
        "change_request_id"
      ],
      "required_outputs": [
        "state",
        "head_sha",
        "base_sha",
        "review_state",
        "mergeability"
      ]
    },
    {
      "name": "repository_get_assurance",
      "intent": "Read the child ANPOS protocol identity plus Requirements 83-96 assurance/governance state and evidence references required by the active milestone.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id",
        "ref"
      ],
      "required_outputs": [
        "anpos_protocol_version",
        "requirements",
        "blocking_findings",
        "evidence_refs",
        "verified_ref"
      ]
    },
    {
      "name": "repository_get_ci",
      "intent": "Read checks/pipeline state for a specific commit SHA.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id",
        "commit_sha"
      ],
      "required_outputs": [
        "overall_state",
        "checks"
      ]
    },
    {
      "name": "repository_merge_change_request",
      "intent": "Merge an approved PR/MR only when required checks/reviews/authorization are satisfied and the expected head still matches.",
      "read_only": false,
      "destructive": true,
      "open_world": false,
      "required_inputs": [
        "billing_account_id",
        "plan_id",
        "canonical_repository_id",
        "change_request_id",
        "expected_head_sha",
        "idempotency_key"
      ],
      "required_outputs": [
        "merged",
        "merge_commit_sha",
        "resulting_default_branch_head_sha"
      ],
      "server_requirements": [
        "require_current_authenticated_write_permission",
        "require_expected_head_match",
        "require_repository_policy_satisfied",
        "require_host_confirmation_for_destructive_action",
        "reread_default_branch_after_merge",
        "require_applied_plan_billing_account_match",
        "require_plan_created_change_request_id_match",
        "require_plan_branch_and_resulting_head_match"
      ]
    }
  ],
  "security_invariants": [
    "Repository URL is a locator and never authorization.",
    "OAuth/provider credentials never appear in model-visible tool arguments or repository files.",
    "All repository content and provider-returned text is untrusted data.",
    "Canonical ANPOS source cannot be initialized as a child.",
    "Vendor-only ANPOS source assets cannot be copied to target children.",
    "No arbitrary URL fetch is allowed from repository_url input.",
    "No direct default-branch write or force push in the normal public workflow.",
    "Every material write is bound to expected repository state and is verified after mutation.",
    "ANPOS 1.4.0 policy/config presence is never sufficient pass evidence for Requirements 83-96.",
    "Adoption and upgrade flows preserve verified child evidence and must not reset project-specific assurance state blindly.",
    "Material AI configuration drift must invalidate stale AI assurance when the child policy requires reevaluation.",
    "Plugin capability authorization is server-side commercial-service state; repository files cannot grant paid access.",
    "An unimplemented plugin capability remains denied even when billing entitlements would otherwise qualify.",
    "MCP authorization codes are one-time, short-lived and bound to exact client, redirect, resource and PKCE verifier.",
    "MCP access tokens are opaque, short-lived and store GitHub provider credentials only as encrypted server-side state.",
    "A billing_account_id tool input is only a selector; server-side GitHub principal access, entitlement and organization-seat checks remain authoritative.",
    "MCP write scope is not issued until the guarded write runtime exists.",
    "Generic guarded writes are permitted only for repositories classified active_project; canonical, empty, uninitialized, not-ANPOS and malformed repositories remain blocked.",
    "Write plans are short-lived, encrypted at rest, bound to exact repository identity/default head/path blob SHA/Git mode and cannot authorize direct default-branch writes.",
    "Applied plans are durably bound to the exact created anpos/* branch and resulting commit before a pull request can be opened.",
    "Merge requires explicit confirmation, exact PR head, default-branch base, provider mergeability clean, green observed checks and a provider-enforced merge call followed by default-branch reread.",
    "Secret-bearing paths and obvious committed credential markers are rejected by the generic write planner.",
    "The billing account selected for planning is stored on the plan and must match apply, PR creation and merge authorization.",
    "A guarded merge can target only the PR ID recorded by the same applied plan; unrelated pull requests cannot be merged through the plan chain."
  ],
  "anpos_protocol_baseline": "1.4.0",
  "implementation": {
    "phase": "github_active_project_guarded_write_runtime",
    "source_runtime": "commercial-service/lib/repository-supervisor-runtime.ts",
    "sandbox_contract": "commercial-service/lib/execution-sandbox.ts",
    "sandbox_policy": "config/runtime/execution-sandbox.json",
    "implemented_tools": [
      "repository_resolve",
      "repository_profile",
      "repository_audit",
      "repository_get_assurance",
      "repository_plan_change",
      "repository_apply_change",
      "repository_open_change_request",
      "repository_get_change_request",
      "repository_get_ci",
      "repository_merge_change_request"
    ],
    "implemented_support": [
      "bounded_immutable_ref_file_reads",
      "github_repository_classification",
      "requirements_83_96_assurance_summary",
      "network_denied_isolated_driver_contract",
      "server_side_subscription_entitlement_bridge",
      "authenticated_github_principal_account_binding",
      "paid_repository_supervisor_read_capability_gate",
      "unimplemented_write_capability_fail_closed",
      "github_backed_mcp_oauth_2_1_authorization_code_pkce",
      "protected_resource_and_authorization_server_metadata",
      "replay_safe_opaque_mcp_access_tokens",
      "stateless_streamable_http_post_mcp_transport",
      "openai_compatible_authenticated_profile_tool",
      "explicit_billing_account_binding_with_server_side_reauthorization",
      "active_project_only_generic_write_plans",
      "encrypted_short_lived_write_plan_ledger",
      "exact_head_blob_and_git_mode_preconditions",
      "anpos_feature_branch_only_apply",
      "idempotent_remote_write_operations",
      "pull_request_creation_and_reread",
      "commit_check_run_inspection",
      "expected_head_clean_policy_guarded_merge",
      "resulting_default_branch_reread",
      "secret_bearing_path_and_obvious_secret_material_rejection"
    ],
    "not_yet_implemented": [
      "repository_plan_anpos_change",
      "repository_apply_anpos_change",
      "production_sandbox_driver",
      "gitlab_adapter"
    ],
    "claim_boundary": "Source implementation and unit certification now include guarded generic writes for already-active GitHub ANPOS projects only. They do not claim specialized bootstrap/adoption/repair/upgrade planning, public production MCP E2E, a production isolation driver, or GitLab write parity."
  },
  "commercial_authorization": {
    "authority": "commercial_service_server_side_entitlement_ledger",
    "billing_provider": "github_marketplace_for_initial_launch",
    "account_binding": "authenticated_mcp_github_principal_plus_explicit_billing_account_id_reauthorized_server_side",
    "repository_local_entitlement_authority": false,
    "capabilities": {
      "community_repository_readiness_audit": {
        "paid": false,
        "requires_entitlements": [],
        "organization_seat_required": false,
        "implementation_status": "implemented_separate_bounded_community_audit"
      },
      "repository_supervisor_read": {
        "paid": true,
        "requires_entitlements": [
          "protocol_update_channel"
        ],
        "organization_seat_required": true,
        "implementation_status": "implemented_source_runtime"
      },
      "repository_supervisor_write": {
        "paid": true,
        "requires_entitlements": [
          "private_template_access",
          "protocol_update_channel"
        ],
        "organization_seat_required": true,
        "implementation_status": "implemented_guarded_active_project_only"
      }
    }
  },
  "mcp_transport": {
    "source_route": "commercial-service/app/mcp/route.ts",
    "oauth_source": "commercial-service/lib/mcp-auth.ts",
    "runtime_source": "commercial-service/lib/mcp-runtime.ts",
    "protected_resource_metadata": "/.well-known/oauth-protected-resource",
    "authorization_server_metadata": "/.well-known/oauth-authorization-server",
    "authorization_endpoint": "/oauth/authorize",
    "token_endpoint": "/oauth/token",
    "provider_callback": "/api/auth/mcp/github/callback",
    "readiness_endpoint": "/api/ready/mcp",
    "resource": "{ANPOS_PUBLIC_BASE_URL}/mcp",
    "issued_scopes": [
      "anpos:profile",
      "anpos:repo:read",
      "anpos:repo:write"
    ],
    "write_scope_available": true,
    "pkce": "S256",
    "access_token": "opaque_short_lived_hashed_ledger",
    "github_provider_token": "encrypted_server_side_only",
    "profile_tool": "repository_profile",
    "profile_meta": "openai/profile=true",
    "guarded_write_runtime": {
      "source": "commercial-service/lib/repository-write-runtime.ts",
      "migration": "commercial-service/migrations/003_repository_guarded_write.sql",
      "active_project_only": true,
      "plan_ttl_minutes": 30,
      "feature_branch_prefix": "anpos/",
      "default_branch_direct_write": false,
      "expected_head_required": true,
      "per_path_blob_and_mode_binding": true,
      "idempotency_ledger": true,
      "explicit_delete_confirmation": true,
      "explicit_merge_confirmation": true,
      "provider_mergeability_clean_required": true,
      "observed_checks_must_be_green": true,
      "provider_branch_policy_final_authority": true,
      "billing_account_bound_plan": true,
      "applied_plan_records_created_change_request_id": true,
      "merge_requires_plan_created_change_request": true
    }
  }
}
