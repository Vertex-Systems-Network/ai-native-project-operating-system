      "signed_remote_ephemeral_sandbox_driver_source",
      "immutable_github_commit_workspace_binding",
      "remote_sandbox_response_signature_and_destruction_evidence",
      "live_github_read_e2e_verifier",
      "phased_guarded_write_e2e_verifier_without_busy_wait",
      "verified_private_template_per_file_git_identity_planning",
      "immutable_target_tree_inventory",
      "bootstrap_empty_plan_generation",
      "bootstrap_child_plan_generation",
      "existing_repository_adoption_plan_generation",
      "partial_anpos_repair_plan_generation",
      "active_project_upgrade_plan_generation",
      "target_only_file_preservation",
