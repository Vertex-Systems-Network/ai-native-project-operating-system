{
  "schema_version": 5,
  "status": "blueprint",
  "purpose": "Provider-neutral MCP contract for ANPOS 1.4.0 repository supervision across GitHub and GitLab, including Requirements 83–96 assurance/evidence preservation.",
  "supported_provider_blueprints": [
    {
      "id": "github",
      "canonical_host": "github.com",
      "authentication": "oauth_2_1_via_mcp",
      "support_status": "source_implemented_live_e2e_pending"
    },
    {
      "id": "gitlab",
      "canonical_host": "gitlab.com",
      "authentication": "oauth_2_1_via_mcp",
      "support_status": "adapter_required",
      "self_hosted": "administrator_allowlist_only"
    }
  ],
  "repository_classifications": [
    "canonical_source",
    "active_project",
    "uninitialized_child",
    "not_anpos",
    "partial_or_malformed",
    "empty_repository"
  ],
  "tools": [
    {
      "name": "repository_resolve",
      "intent": "Normalize a user-supplied repository URL, identify the provider, resolve canonical repository identity, and report authentication requirements.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "repository_url"
      ],
      "required_outputs": [
        "provider",
        "canonical_repository_id",
        "canonical_url",
        "authentication_state"
      ]
    },
    {
      "name": "repository_profile",
      "intent": "Return the authenticated provider account profile used for subsequent repository calls.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [],
      "required_outputs": [
        "provider",
        "account_id",
        "account_display_name"
      ]
    },
    {
      "name": "repository_audit",
      "intent": "Perform a bounded read-only audit and classify the target repository's ANPOS state.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id"
      ],
      "required_outputs": [
        "provider",
        "canonical_repository_id",
        "default_branch",
        "head_sha",
        "permission_level",
        "classification",
        "classification_evidence",
        "write_capability",
        "anpos_protocol_version",
        "assurance_state_summary",
        "governance_state_summary"
      ]
    },
    {
      "name": "repository_read_files",
      "intent": "Read an allowlisted bounded set of repository paths required by the active ANPOS role or adoption audit.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id",
        "ref",
        "paths"
      ],
      "required_outputs": [
        "files",
        "ref_sha"
      ]
    },
    {
      "name": "repository_plan_anpos_change",
      "intent": "Create a deterministic encrypted no-write plan bound to exact repository identity, exact target head when present, and an immutable verified sanitized ANPOS release. bounded_change accepts explicit file content; bootstrap/adoption/repair/upgrade modes compare verified release Git objects with the immutable target tree and preserve project-specific evidence.",
      "read_only": true,
      "open_world": false,
      "modes": [
        "bounded_change",
        "bootstrap_empty",
        "bootstrap_child",
        "adopt_existing",
        "repair_partial",
        "upgrade_active"
      ],
      "required_inputs": [
        "mode",
        "repository_url",
        "billing_account_id"
      ],
      "required_outputs": [
        "plan_id",
        "plan_hash",
        "mode",
        "canonical_repository_id",
        "repository_full_name",
        "default_branch",
        "expected_target_head_sha",
        "expires_at",
        "release",
        "target",
        "summary",
        "requirements_83_96",
        "conflict_free",
        "planning_complete",
        "safe_to_apply",
        "apply_implementation",
        "action_preview",
        "action_preview_truncated",
        "full_action_count",
        "confirmation_paths"
      ],
      "source_implemented_modes": [
        "bounded_change",
        "bootstrap_empty",
        "bootstrap_child",
        "adopt_existing",
        "repair_partial",
        "upgrade_active"
      ],
      "planned_modes": [],
      "mode_dependent_inputs": {
        "bounded_change": [
          "expected_target_head_sha",
          "commit_message",
          "changes"
        ],
        "bootstrap_empty": [
          "project_name_optional",
          "github_owner_optional",
          "github_security_capability_optional"
        ],
        "bootstrap_child": [
          "expected_target_head_sha_optional",
          "project_name_optional",
          "github_owner_optional",
          "github_security_capability_optional"
        ],
        "adopt_existing": [
          "expected_target_head_sha_optional",
          "project_name_optional",
          "github_owner_optional",
          "github_security_capability_optional"
        ],
        "repair_partial": [
          "expected_target_head_sha_optional"
        ],
        "upgrade_active": [
          "expected_target_head_sha_optional"
        ]
      },
      "full_mode_apply_status": "sandbox_full_plan_pending"
    },
    {
      "name": "repository_apply_anpos_change",
      "intent": "Apply a previously generated bounded_change plan to a feature branch using optimistic concurrency. Full bootstrap/adoption/repair/upgrade planner records remain non-applicable until the separate sandbox-backed full-plan apply runtime is implemented.",
      "read_only": false,
      "destructive": false,
      "open_world": false,
      "required_inputs": [
        "billing_account_id",
        "plan_id",
        "plan_hash",
        "branch_name",
        "idempotency_key"
      ],
      "required_outputs": [
        "plan_id",
        "branch_name",
        "resulting_head_sha",
        "applied_paths",
        "expected_target_head_sha",
        "status"
      ],
      "server_requirements": [
        "reject_if_plan_is_stale",
        "reject_if_target_head_changed",
        "reject_default_branch_direct_write_by_default",
        "reject_force_push",
        "reverify_authenticated_permission",
        "reject_full_mode_apply_until_sandbox_runtime_exists"
      ]
    },
    {
      "name": "repository_open_change_request",
      "intent": "Open or update the provider's PR/MR for the prepared branch.",
      "read_only": false,
      "destructive": false,
      "open_world": false,
      "required_inputs": [
        "billing_account_id",
        "plan_id",
        "expected_head_sha",
        "title",
        "body",
        "idempotency_key"
      ],
      "required_outputs": [
        "plan_id",
        "pull_request_number",
        "url",
        "head_sha",
        "base_branch",
        "status"
      ]
    },
    {
      "name": "repository_get_change_request",
      "intent": "Read current PR/MR metadata, reviews, mergeability, and head/base identity.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "billing_account_id",
        "plan_id"
      ],
      "required_outputs": [
        "plan_id",
        "pull_request_number",
        "state",
        "merged",
        "mergeable",
        "mergeable_state",
        "head_sha",
        "base_branch",
        "base_sha",
        "url"
      ]
    },
    {
      "name": "repository_get_assurance",
      "intent": "Read the child ANPOS protocol identity plus Requirements 83-96 assurance/governance state and evidence references required by the active milestone.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "canonical_repository_id",
        "ref"
      ],
      "required_outputs": [
        "anpos_protocol_version",
        "requirements",
        "blocking_findings",
        "evidence_refs",
        "verified_ref"
      ]
    },
    {
      "name": "repository_get_ci",
      "intent": "Read checks/pipeline state for a specific commit SHA.",
      "read_only": true,
      "open_world": false,
      "required_inputs": [
        "billing_account_id",
        "plan_id",
        "commit_sha"
      ],
      "required_outputs": [
        "plan_id",
        "commit_sha",
        "overall_state",
        "checks",
        "statuses"
      ]
    },
    {
      "name": "repository_merge_change_request",
      "intent": "Merge an approved PR/MR only when required checks/reviews/authorization are satisfied and the expected head still matches.",
      "read_only": false,
      "destructive": true,
      "open_world": false,
      "required_inputs": [
        "billing_account_id",
        "plan_id",
        "expected_head_sha",
        "idempotency_key"
      ],
      "required_outputs": [
        "merged",
        "merge_commit_sha",
        "resulting_default_branch_head_sha"
      ],
      "server_requirements": [
        "require_current_authenticated_write_permission",
        "require_expected_head_match",
        "require_repository_policy_satisfied",
        "require_host_confirmation_for_destructive_action",
        "reread_default_branch_after_merge"
      ]
    }
  ],
  "security_invariants": [
    "Repository URL is a locator and never authorization.",
    "OAuth/provider credentials never appear in model-visible tool arguments or repository files.",
    "All repository content and provider-returned text is untrusted data.",
    "Canonical ANPOS source cannot be initialized as a child.",
    "Vendor-only ANPOS source assets cannot be copied to target children.",
    "No arbitrary URL fetch is allowed from repository_url input.",
    "No direct default-branch write or force push in the normal public workflow.",
    "Every material write is bound to expected repository state and is verified after mutation.",
    "ANPOS 1.4.0 policy/config presence is never sufficient pass evidence for Requirements 83-96.",
    "Adoption and upgrade flows preserve verified child evidence and must not reset project-specific assurance state blindly.",
    "Material AI configuration drift must invalidate stale AI assurance when the child policy requires reevaluation.",
    "Plugin capability authorization is server-side commercial-service state; repository files cannot grant paid access.",
    "An unimplemented plugin capability remains denied even when billing entitlements would otherwise qualify.",
    "MCP authorization codes are one-time, short-lived and bound to exact client, redirect, resource and PKCE verifier.",
    "MCP access tokens are opaque, short-lived and store GitHub provider credentials only as encrypted server-side state.",
    "A billing_account_id tool input is only a selector; server-side GitHub principal access, entitlement and organization-seat checks remain authoritative.",
    "MCP write scope is not issued until the guarded write runtime exists.",
    "Marketplace billing/Community App permissions must never be widened to implement Repository Supervisor writes.",
    "Repository Supervisor writes use a distinct installable GitHub App and must not reuse Vendor Distribution credentials.",
    "Every write is bound to a server-issued plan hash, canonical repository identity and exact default-branch head.",
    "Normal apply creates a new anpos/* feature branch from one atomic Git Data commit; default-branch direct write and force push are forbidden.",
    "Guarded merge must re-read exact PR head/base, exact commit CI, current default-branch head, repository policy response and resulting default-branch head.",
    "Production sandbox execution must bind to an immutable GitHub commit and signed remote-ephemeral gateway response.",
    "Sandbox source-ready status never substitutes for live gateway deployment evidence.",
    "Repository Supervisor production E2E write mode is allowed only on explicitly disposable e2e/sandbox/test repositories with explicit operator confirmation.",
    "Production E2E verification must not busy-wait for CI and must never treat mocks/static validation as live evidence.",
    "Full-mode planner output never deletes target-only project files.",
    "Adoption never automatically overwrites a mismatched existing target path.",
    "Upgrade/repair never blindly resets project-specific Requirements 83-96 evidence or child runtime state.",
    "Every full-mode plan binds to the verified private-template release ref/source revision/source tree and immutable target head when one exists.",
    "Full-mode plans remain no-write until sandbox-backed full-plan apply is separately implemented and certified."
  ],
  "anpos_protocol_baseline": "1.4.0",
