      "repository_audit",
      "repository_get_assurance",
      "repository_plan_anpos_change",
      "repository_apply_anpos_change",
      "repository_open_change_request",
      "repository_get_change_request",
      "repository_get_ci",
      "repository_merge_change_request"
    ],
    "implemented_support": [
      "bounded_immutable_ref_file_reads",
      "github_repository_classification",
      "requirements_83_96_assurance_summary",
      "network_denied_isolated_driver_contract",
      "server_side_subscription_entitlement_bridge",
      "authenticated_github_principal_account_binding",
      "paid_repository_supervisor_read_capability_gate",
